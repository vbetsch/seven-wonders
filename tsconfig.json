{
  "exclude": [
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/vitest-report/**",
    "vitest.config.ts"
  ],
  "extends": ["@vbetsch/config-tsconfig/base", "@vbetsch/config-tsconfig/strict"],
  /* Overrides */
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@commands/*": ["./src/app/commands/*"],
      "@usecases/*": ["./src/app/usecases/*"],
      "@engine/*": ["./src/domain/engine/*"],
      "@logic/*": ["./src/domain/logic/*"]
    }
  }
}
