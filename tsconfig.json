{
  "exclude": ["**/coverage/**", "**/dist/**", "**/node_modules/**", "**/vitest-report/**"],
  "extends": ["@vbetsch/config-tsconfig/base", "@vbetsch/config-tsconfig/strict"],
  /* Overrides */
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@commands/*": ["app/commands/*"],
      "@usecases/*": ["app/usecases/*"],
      "@core/*": ["domain/core/*"],
      "@engine/*": ["domain/engine/*"]
    }
  }
}
